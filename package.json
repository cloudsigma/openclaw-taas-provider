{
  "name": "@cloudsigma/openclaw-taas-provider",
  "version": "0.2.4",
  "description": "One plugin. Every leading AI model. Connect OpenClaw to CloudSigma Mission Control for GPT, Claude, Gemini, Kimi, Qwen and more—with streaming, tool calling, live model discovery, session affinity, optimised autorouter and prompt-cache-aware routing built in.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "validate:clawhub": "clawhub package validate . --json",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "cloudsigma",
    "mission-control",
    "taas",
    "ai-gateway",
    "autorouter",
    "session-affinity",
    "prompt-cache",
    "provider",
    "openai-compatible",
    "llm"
  ],
  "author": "CloudSigma",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudsigma/openclaw-taas-provider"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@cloudsigma/openclaw-taas-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "providers": [
      "cloudsigma"
    ],
    "realtimeVoiceProviders": [
      "cloudsigma"
    ]
  },
  "homepage": "https://github.com/cloudsigma/openclaw-taas-provider#readme",
  "bugs": {
    "url": "https://github.com/cloudsigma/openclaw-taas-provider/issues"
  }
}
